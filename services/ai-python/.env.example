# Внутренний токен Go → Flask; не использовать реальное значение из этого примера.
AI_SERVICE_TOKEN=replace-with-local-service-token
# Фиксированный адрес будущего MCP Go; не берётся из сообщения пользователя.
MCP_URL=http://127.0.0.1:8080/mcp
# Реальная LLM ещё не подключена: /health/ready и /internal/v1/turns возвращают 503.
