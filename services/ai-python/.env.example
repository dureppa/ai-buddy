# Внутренний токен Go → Flask; заменить для общей среды.
AI_SERVICE_TOKEN=replace-with-local-service-token
# Адрес Python MCP; локальный demo запускается отдельным процессом.
MCP_URL=http://127.0.0.1:8002/mcp
# Включать явно, когда Ollama и MCP доступны.
AI_AGENT_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-q4_K_M
AI_TURN_TIMEOUT=25
AI_MODEL_TIMEOUT=20

# Отдельный процесс Python MCP: demo или go_http. Demo не заменяет недоступный Go.
MCP_BACKEND=demo
# В режиме go_http: фиксированный origin, HTTP разрешён только для loopback.
GO_API_URL=http://127.0.0.1:8080
# Отдельный секрет Python MCP → Go context/resolve; заменить и согласовать с Go.
MCP_ADAPTER_SERVICE_TOKEN=replace-with-adapter-service-token
# Только для режима demo; не включается автоматически.
MCP_DEMO_ENABLED=false
MCP_DEMO_TOKEN=replace-with-local-demo-token
MCP_DEMO_PROFILE=alex

# Cloud provider: set AI_LLM_PROVIDER=deepseek explicitly. No automatic fallback.
AI_LLM_PROVIDER=ollama
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
