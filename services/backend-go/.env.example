# HTTP-сервер
HTTP_ADDR=:8080
DEMO_MODE=true
SESSION_TTL=24h
SESSION_SECRET=замени-меня-командой-ниже
# sed -i "s|^SESSION_SECRET=.*|SESSION_SECRET=$(openssl rand -hex 32)|" .env

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=aibuddy
PGPASSWORD=aibuddy
PGDATABASE=aibuddy
PGSSLMODE=disable

# Интеграционные тесты
TEST_PGDATABASE=aibuddy_test

# Имитация сбоя корпоративного сервиса для проверки 503 и повтора
CORPORATE_MOCK_FAIL=false
# Optional live AI integration. Keep the secrets separate.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=local-demo-flask-token
MCP_ADAPTER_SERVICE_TOKEN=local-demo-adapter-token
AI_DELEGATION_SECRET=local-demo-delegation-change-for-shared-host
HR_ABSENCES_URL=http://127.0.0.1:8181
HR_TRIPS_URL=http://127.0.0.1:8182
HR_CONSENTS_URL=http://127.0.0.1:8185
HR_DOCUMENTS_URL=http://127.0.0.1:8187
HR_EVENTS_URL=http://127.0.0.1:8188
