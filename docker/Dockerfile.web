FROM node:24.22.2-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/corporate-services/package.json apps/corporate-services/
COPY apps/extension/package.json apps/extension/
RUN --mount=type=cache,target=/root/.npm npm ci
COPY apps/web/ apps/web/
COPY apps/corporate-services/ apps/corporate-services/

FROM build AS web-build
ENV VITE_API_ENABLED=true
ARG PUBLIC_HR_ORIGIN=http://127.0.0.1
ENV VITE_ABSENCES_URL=${PUBLIC_HR_ORIGIN}:5181/ \
    VITE_TRIPS_URL=${PUBLIC_HR_ORIGIN}:5182/ \
    VITE_HIRING_URL=${PUBLIC_HR_ORIGIN}:5183/ \
    VITE_OFFBOARDING_URL=${PUBLIC_HR_ORIGIN}:5184/ \
    VITE_CONSENTS_URL=${PUBLIC_HR_ORIGIN}:5185/ \
    VITE_BENEFITS_URL=${PUBLIC_HR_ORIGIN}:5186/
RUN npm run build --workspace=@ai-buddy/web

FROM nginx:1.28-alpine AS web
COPY --from=web-build /src/apps/web/dist /usr/share/nginx/html
COPY docker/web.conf /etc/nginx/conf.d/default.conf

FROM build AS hr-build
ENV VITE_API_ENABLED=true
ARG PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173
RUN npm run build --workspace=@ai-buddy/corporate-services

FROM nginx:1.28-alpine AS hr-web
COPY --from=hr-build /src/apps/corporate-services/dist /usr/share/nginx/html
COPY docker/hr-web.conf /etc/nginx/conf.d/default.conf
