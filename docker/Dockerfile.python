FROM python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.9.11 /uv /usr/local/bin/uv
WORKDIR /app
ENV PYTHONUNBUFFERED=1 UV_PYTHON_DOWNLOADS=never PATH="/app/.venv/bin:${PATH}"
COPY services/ai-python/pyproject.toml services/ai-python/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv UV_LINK_MODE=copy uv sync --locked --no-dev
COPY services/ai-python/ai_buddy ./ai_buddy
USER 65534:65534
