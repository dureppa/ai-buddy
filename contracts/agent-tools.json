{
  "get_onboarding_progress": {
    "arguments": {
      "additionalProperties": false,
      "properties": {},
      "title": "EmptyArguments",
      "type": "object"
    },
    "result": {
      "$defs": {
        "ProgressData": {
          "additionalProperties": false,
          "properties": {
            "tasks": {
              "items": {
                "$ref": "#/$defs/ProgressTask"
              },
              "maxItems": 100,
              "title": "Tasks",
              "type": "array"
            },
            "next_task_id": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Next Task Id"
            },
            "references": {
              "items": {
                "$ref": "#/$defs/Source"
              },
              "maxItems": 5,
              "title": "References",
              "type": "array"
            }
          },
          "required": [
            "tasks",
            "next_task_id",
            "references"
          ],
          "title": "ProgressData",
          "type": "object"
        },
        "ProgressTask": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
              "title": "Id",
              "type": "string"
            },
            "title": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "status": {
              "enum": [
                "pending",
                "completed"
              ],
              "title": "Status",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "status"
          ],
          "title": "ProgressTask",
          "type": "object"
        },
        "Source": {
          "additionalProperties": false,
          "properties": {
            "title": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "url": {
              "maxLength": 2048,
              "minLength": 1,
              "title": "Url",
              "type": "string"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$",
              "title": "Id",
              "type": "string"
            },
            "version": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Version",
              "type": "string"
            },
            "is_demo": {
              "title": "Is Demo",
              "type": "boolean"
            }
          },
          "required": [
            "title",
            "url",
            "id",
            "version",
            "is_demo"
          ],
          "title": "Source",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "data": {
          "$ref": "#/$defs/ProgressData"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "title": "ProgressEnvelope",
      "type": "object"
    }
  },
