FROM golang:1.26.11-alpine AS build
WORKDIR /src
COPY corporate-services/access/ corporate-services/access/
COPY web/backend/ web/backend/
COPY tools/ tools/
WORKDIR /src/corporate-services/access
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -trimpath -o /server .

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /server /usr/local/bin/server
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/server"]
