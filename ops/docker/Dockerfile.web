FROM node:24.22.2-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY web/package.json web/
COPY ops/service-sites/package.json ops/service-sites/
COPY extension/package.json extension/
RUN --mount=type=cache,target=/root/.npm npm ci
COPY web/ web/
COPY ops/service-sites/ ops/service-sites/
COPY tools/ tools/
COPY corporate-services/access/frontend/ corporate-services/access/frontend/
COPY web/backend/internal/portal/catalog.json web/backend/internal/portal/
COPY corporate-services/ corporate-services/

FROM build AS web-build
ENV VITE_API_ENABLED=true
ARG PUBLIC_HR_ORIGIN=http://127.0.0.1
ENV VITE_WORK_TOOLS_URL=${PUBLIC_HR_ORIGIN}:5192
ENV VITE_ABSENCES_URL=${PUBLIC_HR_ORIGIN}:5181/ \
    VITE_TRIPS_URL=${PUBLIC_HR_ORIGIN}:5182/ \
    VITE_HIRING_URL=${PUBLIC_HR_ORIGIN}:5183/ \
    VITE_OFFBOARDING_URL=${PUBLIC_HR_ORIGIN}:5184/ \
    VITE_CONSENTS_URL=${PUBLIC_HR_ORIGIN}:5185/ \
    VITE_BENEFITS_URL=${PUBLIC_HR_ORIGIN}:5186/ \
    VITE_DOCUMENTS_URL=${PUBLIC_HR_ORIGIN}:5187/ \
    VITE_EVENTS_URL=${PUBLIC_HR_ORIGIN}:5188/ \
    VITE_JIRA_URL=${PUBLIC_HR_ORIGIN}:5189/ \
    VITE_ACCESS_URL=${PUBLIC_HR_ORIGIN}:5190/ \
    VITE_CONFLUENCE_URL=${PUBLIC_HR_ORIGIN}:5191/
RUN npm run build --workspace=@ai-buddy/web

FROM nginx:1.28-alpine AS web
COPY --from=web-build /src/web/dist /usr/share/nginx/html
COPY ops/docker/web.conf /etc/nginx/conf.d/default.conf

FROM build AS hr-build
ENV VITE_API_ENABLED=true
ARG PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173
RUN npm run build --workspace=@ai-buddy/corporate-services

FROM nginx:1.28-alpine AS hr-web
COPY --from=hr-build /src/ops/service-sites/dist /usr/share/nginx/html
COPY ops/docker/hr-web.conf /etc/nginx/conf.d/default.conf
