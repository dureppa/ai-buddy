FROM node:24.22.2-bookworm-slim AS node
FROM golang:1.26.11-bookworm AS go
FROM python:3.13-slim-bookworm

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=go /usr/local/go /usr/local/go
COPY --from=ghcr.io/astral-sh/uv:0.9.11 /uv /usr/local/bin/uv
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && mkdir -p /app /go /go-build /uv-cache \
    && chown 65534:65534 /app /go /go-build /uv-cache

ENV PATH="/usr/local/go/bin:${PATH}" \
    HOME=/tmp \
    GOPATH=/go \
    GOCACHE=/go-build \
    GOTOOLCHAIN=local \
    CGO_ENABLED=0 \
    UV_CACHE_DIR=/uv-cache \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1
WORKDIR /app
USER 65534:65534

COPY --chown=65534:65534 package.json package-lock.json ./
COPY --chown=65534:65534 web/package.json ./web/
COPY --chown=65534:65534 extension/package.json ./extension/
COPY --chown=65534:65534 ops/service-sites/package.json ./ops/service-sites/
RUN npm ci --no-audit --no-fund

COPY --chown=65534:65534 ai-agent/pyproject.toml ai-agent/uv.lock ./ai-agent/
RUN cd ai-agent && uv sync --locked --python /usr/local/bin/python3

COPY --chown=65534:65534 web/backend/go.mod web/backend/go.sum ./web/backend/
RUN cd web/backend && go mod download

COPY --chown=65534:65534 web/ ./web/
COPY --chown=65534:65534 ai-agent/ ./ai-agent/
COPY --chown=65534:65534 tools/ ./tools/
COPY --chown=65534:65534 corporate-services/ ./corporate-services/
COPY --chown=65534:65534 ops/service-sites/ ./ops/service-sites/
COPY --chown=65534:65534 ops/checks/load-suite.sh ./ops/checks/load-suite.sh
RUN cd web/backend && go test ./internal/httpapi -run '^$'

# Dependency resolution happens during build. The launcher also disables networking.
ENV GOPROXY=off GOSUMDB=off UV_OFFLINE=1
ENTRYPOINT ["sh", "/app/ops/checks/load-suite.sh"]
