# Необязательные настройки локального Docker Compose. Скопируй в .env для переопределения.
AI_BUDDY_WEB_PORT=5173
COMPOSE_DB_PASSWORD=local-aibuddy-secret
COMPOSE_HR_DB_PASSWORD=local-hr-secret
COMPOSE_SESSION_SECRET=local-demo-session-change-for-shared-host

# Flask и MCP используют разные токены. Python MCP работает на синтетических данных.
COMPOSE_AI_TOKEN=local-demo-flask-token
COMPOSE_MCP_TOKEN=local-demo-mcp-token
COMPOSE_MCP_PROFILE=alex

OLLAMA_IMAGE_TAG=0.40.16
OLLAMA_MODEL=qwen3:4b-q4_K_M
