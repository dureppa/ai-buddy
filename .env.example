# Необязательные настройки локального Docker Compose. Скопируй в .env для переопределения.
AI_BUDDY_WEB_PORT=5173
COMPOSE_DB_PASSWORD=local-aibuddy-secret
COMPOSE_HR_DB_PASSWORD=local-hr-secret
COMPOSE_SESSION_SECRET=local-demo-session-change-for-shared-host

# Go вызывает Flask, Python MCP читает Go с отдельной авторизацией.
COMPOSE_AI_TOKEN=local-demo-flask-token


# Live Go → Flask → MCP → Go; separate development credentials.
COMPOSE_MCP_ADAPTER_TOKEN=local-demo-adapter-token
COMPOSE_DELEGATION_SECRET=local-demo-delegation-change-for-shared-host
AI_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Public browser origins for a remote demo (no trailing slash).
PUBLIC_HR_ORIGIN=http://127.0.0.1
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173

# Standalone Jira demo (--profile jira).
COMPOSE_JIRA_DB_PASSWORD=local-jira-secret
COMPOSE_JIRA_SESSION_SECRET=local-jira-session-secret-change-for-shared-host
