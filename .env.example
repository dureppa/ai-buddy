# Необязательные настройки локального Docker Compose. Скопируй в .env.
# Для чата жюри подставляет свой ключ. Пустой ключ не заменяет ответ учебным текстом.
AI_BUDDY_WEB_PORT=5173
COMPOSE_DB_PASSWORD=local-aibuddy-secret
COMPOSE_SESSION_SECRET=local-demo-session-change-for-shared-host

# Go вызывает Flask, Python MCP читает Go с отдельной авторизацией.
COMPOSE_AI_TOKEN=local-demo-flask-token


# Live Go → Flask → MCP → Go; separate development credentials.
COMPOSE_MCP_ADAPTER_TOKEN=local-demo-adapter-token
COMPOSE_DELEGATION_SECRET=local-demo-delegation-change-for-shared-host
AI_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Public browser origins for a remote demo (no trailing slash).
PUBLIC_HR_ORIGIN=http://127.0.0.1
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173

# Jira (--profile jira); один COMPOSE_JIRA_SESSION_SECRET используется Jira и Go-агентом.
# PUBLIC_HR_ORIGIN определяет также ссылки найма, увольнений, бенефитов и Jira.
COMPOSE_JIRA_DB_PASSWORD=local-jira-secret
COMPOSE_JIRA_SESSION_SECRET=local-jira-session-secret-change-for-shared-host

# Confluence API and database
COMPOSE_CONFLUENCE_DB_PASSWORD=local-confluence-db-password
COMPOSE_CONFLUENCE_SESSION_SECRET=local-confluence-session-secret-change-me
COMPOSE_CONFLUENCE_DELEGATION_SECRET=local-confluence-delegation-secret-change-me

# External work-tool API sessions and Buddy delegation
COMPOSE_WORK_TOOL_SESSION_SECRET=local-work-tool-session-secret-change-me
COMPOSE_WORK_TOOL_DELEGATION_SECRET=local-work-tool-delegation-secret-change-me

# Access portal and its database
COMPOSE_ACCESS_DB_PASSWORD=local-access-db-password
COMPOSE_ACCESS_SESSION_SECRET=local-access-session-secret-change-me
COMPOSE_ACCESS_DELEGATION_SECRET=local-access-delegation-secret-change-me

# Optional per-service overrides for HR databases and demo sessions
COMPOSE_HR_ABSENCES_DB_PASSWORD=local-hr-absences-db-password
COMPOSE_HR_ABSENCES_SESSION_SECRET=local-hr-absences-session-secret-change-me
COMPOSE_HR_TRIPS_DB_PASSWORD=local-hr-trips-db-password
COMPOSE_HR_TRIPS_SESSION_SECRET=local-hr-trips-session-secret-change-me
COMPOSE_HR_HIRING_DB_PASSWORD=local-hr-hiring-db-password
COMPOSE_HR_HIRING_SESSION_SECRET=local-hr-hiring-session-secret-change-me
COMPOSE_HR_OFFBOARDING_DB_PASSWORD=local-hr-offboarding-db-password
COMPOSE_HR_OFFBOARDING_SESSION_SECRET=local-hr-offboarding-session-secret-change-me
COMPOSE_HR_CONSENTS_DB_PASSWORD=local-hr-consents-db-password
COMPOSE_HR_CONSENTS_SESSION_SECRET=local-hr-consents-session-secret-change-me
COMPOSE_HR_BENEFITS_DB_PASSWORD=local-hr-benefits-db-password
COMPOSE_HR_BENEFITS_SESSION_SECRET=local-hr-benefits-session-secret-change-me
COMPOSE_HR_DOCUMENTS_DB_PASSWORD=local-hr-documents-db-password
COMPOSE_HR_DOCUMENTS_SESSION_SECRET=local-hr-documents-session-secret-change-me
COMPOSE_HR_EVENTS_DB_PASSWORD=local-hr-events-db-password
COMPOSE_HR_EVENTS_SESSION_SECRET=local-hr-events-session-secret-change-me
