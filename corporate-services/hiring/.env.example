HTTP_ADDR=:8183

# PostgreSQL — рабочая база и роль сервиса
PGHOST=localhost
PGPORT=5432
PGUSER=hr_hiring
PGPASSWORD=hr_hiring
PGDATABASE=hr_hiring
PGSSLMODE=disable

# Суперпользователь: нужен только для CREATE ROLE / CREATE DATABASE при старте
PGADMIN_USER=postgres
PGADMIN_PASSWORD=postgres

# Секрет подписи токенов ядра AI Buddy — обязан совпадать с web/backend/.env
SESSION_SECRET=change-me-at-least-32-characters-long
DEMO_MODE=true
HR_DEMO_SIGNING_SECRET=local-hr-hiring-session-secret-change-me
